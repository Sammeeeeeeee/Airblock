<?xml version="1.0" encoding="utf-8"?>
<!-- Flight strip colours: Material 3 roles on the system's dynamic palette
     (the same tones Glance gives the Airblock card), so the strip follows the
     wallpaper colours and light/dark like the rest of the home screen. The
     launcher resolves these, not the app. Error and positive tones are fixed
     M3 baseline values: Android has no dynamic error palette. -->
<resources>
    <color name="strip_surface">@android:color/system_accent2_50</color>
    <color name="strip_on_surface">@android:color/system_neutral1_900</color>
    <color name="strip_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="strip_primary">@android:color/system_accent1_600</color>
    <color name="strip_on_primary">@android:color/system_accent1_0</color>
    <color name="strip_primary_container">@android:color/system_accent1_100</color>
    <color name="strip_on_primary_container">@android:color/system_accent1_900</color>
    <color name="strip_surface_variant">@android:color/system_neutral2_100</color>
    <color name="strip_outline">@android:color/system_neutral2_500</color>
    <color name="strip_secondary_container">@android:color/system_accent2_100</color>
    <color name="strip_on_secondary_container">@android:color/system_accent2_900</color>
    <color name="strip_tertiary">@android:color/system_accent3_600</color>
    <color name="strip_on_tertiary">@android:color/system_accent3_0</color>
    <color name="strip_tertiary_container">@android:color/system_accent3_100</color>
    <color name="strip_on_tertiary_container">@android:color/system_accent3_900</color>
    <color name="strip_on_tertiary_container_variant">@android:color/system_accent3_700</color>
    <color name="strip_error">#FFB3261E</color>
    <color name="strip_on_error">#FFFFFFFF</color>
    <color name="strip_error_container">#FFF9DEDC</color>
    <color name="strip_on_error_container">#FF410E0B</color>
    <color name="strip_on_error_container_variant">#FF8C1D18</color>
    <color name="strip_positive">#FF146C2E</color>
</resources>
