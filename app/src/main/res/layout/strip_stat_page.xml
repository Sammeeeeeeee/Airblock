<?xml version="1.0" encoding="utf-8"?>
<!-- One page of the stats pill: one pre-drawn line and the page dots that
     show it pages up and down. Sized and padded from code (FlightStrip.stats). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/strip_page"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/strip_page_fill"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/strip_page_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:importantForAccessibility="no"
        android:scaleType="matrix" />

    <ImageView
        android:id="@+id/strip_page_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="11dp"
        android:importantForAccessibility="no" />
</LinearLayout>
