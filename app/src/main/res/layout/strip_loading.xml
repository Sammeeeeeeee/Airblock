<?xml version="1.0" encoding="utf-8"?>
<!-- Shown for the moment before the first real frame arrives. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/strip_pill"
        android:backgroundTint="@color/strip_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:rotation="45"
            android:src="@drawable/ic_flight"
            android:tint="@color/strip_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/strip_label"
            android:textColor="@color/strip_on_surface"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
